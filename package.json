{
  "name": "cashwatch",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "description": "מעקב תזרים יומי לחשבונות בנק וכרטיסי אשראי בישראל, עם התראות בוואטסאפ/מייל ודשבורד",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js serve",
    "dev": "tsx src/cli.ts serve",
    "run-once": "tsx src/cli.ts run",
    "demo": "tsx src/cli.ts demo",
    "check-config": "tsx src/cli.ts check-config",
    "test-notify": "tsx src/cli.ts test-notify",
    "test-connection": "tsx src/cli.ts test-connection",
    "browser-login": "tsx src/cli.ts browser-login",
    "otp-setup": "tsx src/cli.ts otp-setup",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "israeli-bank-scrapers": "6.13.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
